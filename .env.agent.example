# 复制为 .env 后再填入真实值；.env 已被 Git 忽略。
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password
AGENT_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
MINIO_ROOT_USER=replace-with-a-private-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret

# 支持 OpenAI 兼容模型接口。
OPENAI_API_KEY=replace-with-your-model-api-key
OPENAI_BASE_URL=
AGENT_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 留空时使用仓库内置的“余”人物人格；填写后可完整覆盖默认人格。
AGENT_PERSONA=
